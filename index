<!DOCTYPE html>
<html lang="fa">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>استودیو موشن سه‌بعدی دایره البروج | Zodiac 3D Motion Studio</title>

  <!-- Tailwind CSS -->
  <script src="https://cdn.tailwindcss.com"></script>

  <!-- Three.js (r128) برای رندرینگ رئالیستیک سه‌بعدی -->
  <script src="https://cdnjs.cloudflare.com/ajax/libs/three.js/r128/three.min.js"></script>

  <!-- فونت فارسی Vazirmatn و فونت انگلیسی Inter -->
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&family=Vazirmatn:wght@300;400;500;600;700&display=swap" rel="stylesheet" />

  <style>
    :root {
      --bg-studio: #05070d;
      --panel-bg: #0c111d;
      --card-bg: #121827;
      --border-subtle: rgba(255, 255, 255, 0.08);
      --accent-blue: #3F8FFE;
    }

    * {
      box-sizing: border-box;
    }

    body {
      margin: 0;
      padding: 0;
      background-color: var(--bg-studio);
      color: #e6edf7;
      font-family: 'Vazirmatn', 'Inter', sans-serif;
      display: flex;
      flex-direction: row;
      flex-wrap: nowrap;
      width: 100%;
      height: 100vh;
      overflow-x: auto;
      overflow-y: hidden;
    }

    .font-mono-num {
      font-family: 'Inter', monospace;
      font-variant-numeric: tabular-nums;
    }

    /* اسکرول‌بار ظریف برای پنل کنترل */
    .custom-scroll::-webkit-scrollbar {
      width: 6px;
    }
    .custom-scroll::-webkit-scrollbar-track {
      background: rgba(255, 255, 255, 0.02);
    }
    .custom-scroll::-webkit-scrollbar-thumb {
      background: rgba(255, 255, 255, 0.14);
      border-radius: 9999px;
    }
    .custom-scroll::-webkit-scrollbar-thumb:hover {
      background: rgba(255, 255, 255, 0.25);
    }

    /* فرم مجزای 9:16 بدون هیچ ورودی در داخل آن */
    #stage-pane {
      container-type: size;
    }

    #stage-9-16 {
      position: relative;
      height: calc(100vh - 16px);
      width: auto;
      height: min(100cqh, calc(100cqw * 16 / 9));
      width: min(100cqw, calc(100cqh * 9 / 16));
      aspect-ratio: 9 / 16;
      border-radius: 18px;
      overflow: hidden;
      background-color: #060911;
      background-size: cover;
      background-position: center;
      box-shadow:
        0 25px 60px rgba(0, 0, 0, 0.75),
        0 0 0 1px rgba(255, 255, 255, 0.12);
      flex-shrink: 0;
    }

    #stage-canvas-wrapper {
      position: absolute;
      inset: 0;
      width: 100%;
      height: 100%;
    }

    #stage-canvas-wrapper canvas {
      display: block;
      width: 100% !important;
      height: 100% !important;
    }

    /* اسلایدر سفارشی */
    input[type="range"] {
      -webkit-appearance: none;
      appearance: none;
      background: rgba(255, 255, 255, 0.1);
      height: 5px;
      border-radius: 999px;
      outline: none;
    }
    input[type="range"]::-webkit-slider-thumb {
      -webkit-appearance: none;
      appearance: none;
      width: 15px;
      height: 15px;
      border-radius: 50%;
      background: #3F8FFE;
      border: 2px solid #ffffff;
      cursor: pointer;
      box-shadow: 0 0 10px rgba(63, 143, 254, 0.65);
      transition: transform 0.15s ease;
    }
    input[type="range"]::-webkit-slider-thumb:hover {
      transform: scale(1.15);
    }

    /* کنترلر کره‌ای سه‌بعدی (Trackball Gizmo) برای چرخش آزاد زاویه دوربین */
    #camera-gizmo {
      position: relative;
      width: 136px;
      height: 136px;
      border-radius: 50%;
      background:
        radial-gradient(circle at 35% 30%, rgba(63, 143, 254, 0.28), rgba(10, 16, 30, 0.95) 70%);
      border: 1px solid rgba(63, 143, 254, 0.45);
      box-shadow:
        inset 0 0 24px rgba(63, 143, 254, 0.2),
        0 8px 24px rgba(0, 0, 0, 0.5);
      cursor: grab;
      touch-action: none;
      user-select: none;
    }
    #camera-gizmo:active {
      cursor: grabbing;
      border-color: rgba(91, 216, 80, 0.75);
    }

    /* خطوط شبکه داخل نشانگر سه‌بعدی */
    .gizmo-ring-h {
      position: absolute;
      top: 50%;
      left: 8%;
      right: 8%;
      height: 1px;
      background: rgba(255, 255, 255, 0.14);
      pointer-events: none;
    }
    .gizmo-ring-v {
      position: absolute;
      left: 50%;
      top: 8%;
      bottom: 8%;
      width: 1px;
      background: rgba(255, 255, 255, 0.14);
      pointer-events: none;
    }
    .gizmo-ellipse {
      position: absolute;
      inset: 18%;
      border-radius: 50%;
      border: 1px dashed rgba(255, 255, 255, 0.16);
      pointer-events: none;
    }

    #gizmo-knob {
      position: absolute;
      width: 18px;
      height: 18px;
      border-radius: 50%;
      background: radial-gradient(circle at 35% 35%, #ffffff, #3F8FFE 65%);
      box-shadow: 0 0 14px rgba(63, 143, 254, 0.95);
      transform: translate(-50%, -50%);
      left: 50%;
      top: 50%;
      pointer-events: none;
      transition: box-shadow 0.15s ease;
    }

    /* پیام غیرمزاحم (جایگزین alert) */
    #toast-box {
      position: fixed;
      bottom: 20px;
      left: 20px;
      z-index: 100;
      transform: translateY(120%);
      opacity: 0;
      transition: all 0.3s ease;
      pointer-events: none;
    }
    #toast-box.show {
      transform: translateY(0);
      opacity: 1;
    }
  </style>
</head>
<body class="h-screen w-full flex flex-row overflow-x-auto overflow-y-hidden">

  <!-- ====================================================================== -->
  <!-- بخش سمت چپ: استیج مجزای 9:16 (هیچ ورودی یا دکمه‌ای داخل فرم نیست)    -->
  <!-- ====================================================================== -->
  <main id="stage-pane" class="flex-1 min-w-[320px] h-screen flex items-center justify-center p-2 bg-[#05070d] overflow-hidden">
    <div id="stage-9-16" aria-label="Zodiac 9:16 Motion Stage">
      <div id="stage-canvas-wrapper"></div>
    </div>
  </main>

  <!-- ====================================================================== -->
  <!-- بخش سمت راست: پنل کنترل و ورودی‌ها (دقیقاً سمت راست فرم 9:16)          -->
  <!-- ====================================================================== -->
  <aside dir="rtl" class="w-[360px] lg:w-[410px] xl:w-[430px] min-w-[340px] h-screen bg-[#0c111d] border-l border-white/10 flex flex-col shrink-0">

    <!-- هدر پنل -->
    <div class="px-5 py-4 border-b border-white/10 flex items-center justify-between bg-[#0f1524]">
      <div>
        <h1 class="text-base font-bold text-white tracking-tight">کنترل پنل موشن دایره البروج</h1>
        <p class="text-[11px] text-slate-400 mt-0.5">فرم ۹:۱۶ مجزا • رندر سه‌بعدی رئالیستیک</p>
      </div>
      <button id="btn-reset-all" type="button" class="px-3 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 border border-white/10 text-xs text-slate-300 transition">
        حالت پیش‌فرض عکس
      </button>
    </div>

    <!-- بدنه اسکرول‌دار ورودی‌ها -->
    <div class="flex-1 overflow-y-auto custom-scroll p-4 space-y-4">

      <!-- کارت ۱: موقعیت محور و سیاره (ماه) -->
      <section class="bg-[#121827] border border-white/10 rounded-xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#5BD850] shadow-[0_0_8px_#5BD850]"></span>
            موقعیت محور و سیاره (روی دایره نقطه‌چین)
          </h2>
          <span id="planet-total-deg-badge" class="font-mono-num text-xs px-2 py-0.5 rounded-md bg-white/5 text-slate-300 border border-white/10">56.0°</span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="planet-sign" class="block text-xs text-slate-400 mb-1">انتخاب نشان</label>
            <select id="planet-sign" class="w-full bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-2 text-xs text-white focus:outline-none focus:border-[#3F8FFE]"></select>
          </div>
          <div>
            <label for="planet-deg" class="block text-xs text-slate-400 mb-1">درجه داخل نشان (۰ تا ۳۰)</label>
            <input id="planet-deg" type="number" min="0" max="30" step="0.5" value="26" class="font-mono-num w-full bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-2 text-xs text-white focus:outline-none focus:border-[#3F8FFE]" />
          </div>
        </div>

        <input id="planet-deg-slider" type="range" min="0" max="30" step="0.5" value="26" class="w-full" />

        <div class="pt-1 space-y-1.5">
          <span class="block text-[11px] text-slate-400">حالت حرکت سیاره و محور:</span>
          <div class="grid grid-cols-2 gap-1 bg-[#090d17] p-1 rounded-lg border border-white/10 text-[11px]">
            <button type="button" data-move-mode="axis" class="move-mode-btn py-1.5 px-2 rounded-md bg-[#3F8FFE] text-white font-medium transition">حرکت محور (خط نقطه‌چین)</button>
            <button type="button" data-move-mode="free" class="move-mode-btn py-1.5 px-2 rounded-md text-slate-400 hover:text-white transition">حرکت آزاد سیاره</button>
          </div>
        </div>

        <div class="flex items-center justify-between pt-1">
          <span class="text-[11px] text-slate-400">جهت چرخش محور:</span>
          <div class="flex bg-[#090d17] p-0.5 rounded-lg border border-white/10 text-[11px]">
            <button type="button" data-dir="shortest" class="dir-btn px-2.5 py-1 rounded-md bg-[#3F8FFE] text-white font-medium transition">کوتاه‌ترین</button>
            <button type="button" data-dir="ccw" class="dir-btn px-2.5 py-1 rounded-md text-slate-400 hover:text-white transition">پادساعتگرد</button>
          </div>
        </div>
      </section>

      <!-- کارت ۲: موقعیت خورشید -->
      <section class="bg-[#121827] border border-white/10 rounded-xl p-4 space-y-3">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#E5C94E] shadow-[0_0_8px_#E5C94E]"></span>
            موقعیت خورشید (چسبیده به خط داخلی دایره)
          </h2>
          <span id="sun-total-deg-badge" class="font-mono-num text-xs px-2 py-0.5 rounded-md bg-white/5 text-slate-300 border border-white/10">69.0°</span>
        </div>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="sun-sign" class="block text-xs text-slate-400 mb-1">انتخاب نشان خورشید</label>
            <select id="sun-sign" class="w-full bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-2 text-xs text-white focus:outline-none focus:border-[#E5C94E]"></select>
          </div>
          <div>
            <label for="sun-deg" class="block text-xs text-slate-400 mb-1">درجه داخل نشان (۰ تا ۳۰)</label>
            <input id="sun-deg" type="number" min="0" max="30" step="0.5" value="9" class="font-mono-num w-full bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-2 text-xs text-white focus:outline-none focus:border-[#E5C94E]" />
          </div>
        </div>

        <input id="sun-deg-slider" type="range" min="0" max="30" step="0.5" value="9" class="w-full" />
      </section>

      <!-- کارت ۳: دیوریشن و دکمه اجرای موشن -->
      <section class="bg-[#121827] border border-white/10 rounded-xl p-4 space-y-3">
        <h2 class="text-sm font-semibold text-white flex items-center gap-2">
          <span class="w-2.5 h-2.5 rounded-full bg-[#3F8FFE] shadow-[0_0_8px_#3F8FFE]"></span>
          دیوریشن و اجرای انیمیشن
        </h2>

        <div class="grid grid-cols-2 gap-3">
          <div>
            <label for="motion-duration" class="block text-xs text-slate-400 mb-1">دیوریشن موشن (ثانیه)</label>
            <input id="motion-duration" type="number" min="0.2" max="30" step="0.5" value="4" class="font-mono-num w-full bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-2 text-xs text-white focus:outline-none focus:border-[#3F8FFE]" />
          </div>
          <div>
            <label for="camera-duration" class="block text-xs text-slate-400 mb-1">دیوریشن دوربین (ثانیه)</label>
            <input id="camera-duration" type="number" min="0.2" max="30" step="0.5" value="4" class="font-mono-num w-full bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-2 text-xs text-white focus:outline-none focus:border-[#3F8FFE]" />
          </div>
        </div>

        <button id="btn-run-motion" type="button" class="w-full py-2.5 px-4 rounded-xl bg-gradient-to-l from-[#3F8FFE] to-[#2563eb] hover:from-[#539cff] hover:to-[#3b82f6] text-white font-semibold text-sm shadow-lg shadow-blue-500/25 transition active:scale-[0.98]">
          اعمال دیتا و اجرای موشن
        </button>
      </section>

      <!-- کارت ۴: دوربین سه‌بعدی رئالیستیک و زوم -->
      <section class="bg-[#121827] border border-white/10 rounded-xl p-4 space-y-4">
        <div class="flex items-center justify-between">
          <h2 class="text-sm font-semibold text-white flex items-center gap-2">
            <span class="w-2.5 h-2.5 rounded-full bg-[#FF4230] shadow-[0_0_8px_#FF4230]"></span>
            زاویه دوربین سه‌بعدی و زوم
          </h2>
          <button id="btn-reset-camera" type="button" class="text-[11px] text-[#3F8FFE] hover:text-blue-300 transition">
            نمای روبرو (ریست)
          </button>
        </div>

        <!-- انتخاب حالت دوربین سه‌بعدی -->
        <div class="grid grid-cols-3 gap-1.5 bg-[#090d17] p-1 rounded-xl border border-white/10">
          <button type="button" data-cam-mode="free" class="cam-mode-btn py-2 px-1.5 rounded-lg text-[11px] font-medium bg-[#3F8FFE] text-white transition">
            زاویه آزاد ۳D
          </button>
          <button type="button" data-cam-mode="planet" class="cam-mode-btn py-2 px-1.5 rounded-lg text-[11px] font-medium text-slate-400 hover:text-white transition">
            روبروی سیاره
          </button>
          <button type="button" data-cam-mode="axis" class="cam-mode-btn py-2 px-1.5 rounded-lg text-[11px] font-medium text-slate-400 hover:text-white transition">
            همراه با محور
          </button>
        </div>

        <!-- نشانگر کره‌ای سه‌بعدی برای چرخاندن دوربین به هر سمت -->
        <div class="flex items-center gap-4 bg-[#090d17]/70 p-3 rounded-xl border border-white/5">
          <div id="camera-gizmo" title="بکشید تا دوربین سه‌بعدی بچرخد">
            <div class="gizmo-ring-h"></div>
            <div class="gizmo-ring-v"></div>
            <div class="gizmo-ellipse"></div>
            <div id="gizmo-knob"></div>
          </div>

          <div class="flex-1 space-y-2.5">
            <div>
              <div class="flex justify-between text-[11px] mb-1">
                <span class="text-slate-400">زاویه افقی (Yaw)</span>
                <span id="yaw-val" class="font-mono-num text-white">0°</span>
              </div>
              <input id="cam-yaw" type="range" min="-180" max="180" step="1" value="0" class="w-full" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] mb-1">
                <span class="text-slate-400">زاویه عمودی (Pitch)</span>
                <span id="pitch-val" class="font-mono-num text-white">0°</span>
              </div>
              <input id="cam-pitch" type="range" min="-72" max="72" step="1" value="0" class="w-full" />
            </div>

            <div>
              <div class="flex justify-between text-[11px] mb-1">
                <span class="text-slate-400">میزان زوم (Zoom)</span>
                <span id="zoom-val" class="font-mono-num text-white">1.00x</span>
              </div>
              <input id="cam-zoom" type="range" min="0.5" max="3.8" step="0.05" value="1" class="w-full" />
            </div>
          </div>
        </div>

        <button id="btn-apply-camera" type="button" class="w-full py-2 px-3 rounded-xl bg-white/10 hover:bg-white/15 border border-white/15 text-xs font-medium text-white transition">
          حرکت نرم دوربین با دیوریشن تعیین‌شده
        </button>
      </section>

      <!-- کارت ۵: تغییر تصاویر با URL و تغییر پس‌زمینه -->
      <section class="bg-[#121827] border border-white/10 rounded-xl p-4 space-y-3.5">
        <h2 class="text-sm font-semibold text-white">شخصی‌سازی تصاویر (URL) و پس‌زمینه</h2>

        <!-- تصویر سیاره روی محور -->
        <div>
          <label for="planet-url" class="block text-xs text-slate-400 mb-1">لینک تصویر سیاره روی محور (URL)</label>
          <div class="flex gap-1.5">
            <input id="planet-url" type="url" dir="ltr" placeholder="https://example.com/planet.png" class="flex-1 bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-[#3F8FFE]" />
            <button id="btn-set-planet-url" type="button" class="px-3 py-1.5 rounded-lg bg-[#3F8FFE]/20 hover:bg-[#3F8FFE]/35 border border-[#3F8FFE]/40 text-xs text-blue-200 transition">اعمال</button>
            <button id="btn-clear-planet-url" type="button" class="px-2.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-slate-400 transition" title="بازگشت به پیش‌فرض">✕</button>
          </div>
        </div>

        <!-- تصویر خورشید -->
        <div>
          <label for="sun-url" class="block text-xs text-slate-400 mb-1">لینک تصویر خورشید (URL)</label>
          <div class="flex gap-1.5">
            <input id="sun-url" type="url" dir="ltr" placeholder="https://example.com/sun.png" class="flex-1 bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-[#E5C94E]" />
            <button id="btn-set-sun-url" type="button" class="px-3 py-1.5 rounded-lg bg-[#E5C94E]/20 hover:bg-[#E5C94E]/35 border border-[#E5C94E]/40 text-xs text-amber-200 transition">اعمال</button>
            <button id="btn-clear-sun-url" type="button" class="px-2.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-slate-400 transition" title="بازگشت به پیش‌فرض">✕</button>
          </div>
        </div>

        <!-- تنظیمات پس‌زمینه فرم 9:16 -->
        <div class="pt-2 border-t border-white/10 space-y-2.5">
          <span class="block text-xs text-slate-300 font-medium">بک‌گراند فرم ۹:۱۶</span>

          <div class="flex items-center gap-3">
            <label class="flex items-center gap-2 text-xs text-slate-400 cursor-pointer">
              <input id="bg-color-picker" type="color" value="#060911" class="w-8 h-7 rounded bg-transparent border border-white/20 cursor-pointer" />
              <span>رنگ پس‌زمینه</span>
            </label>

            <label class="flex items-center gap-2 text-xs text-slate-400 cursor-pointer mr-auto">
              <input id="toggle-stars" type="checkbox" checked class="accent-[#3F8FFE] w-4 h-4 rounded" />
              <span>ستارگان سه‌بعدی</span>
            </label>
          </div>

          <!-- کنترل میزان ستارگان رئالیستیک پس‌زمینه -->
          <div class="space-y-1.5 pt-1">
            <div class="flex items-center justify-between text-xs">
              <label for="star-count-input" class="text-slate-400">میزان ستارگان پس‌زمینه</label>
              <input id="star-count-input" type="number" min="0" max="5000" step="50" value="1500" class="font-mono-num w-20 bg-[#090d17] border border-white/15 rounded-md px-2 py-0.5 text-[11px] text-white text-center focus:outline-none focus:border-[#3F8FFE]" />
            </div>
            <input id="star-count-slider" type="range" min="0" max="5000" step="50" value="1500" class="w-full" />
          </div>

          <div class="flex gap-1.5">
            <input id="bg-url" type="url" dir="ltr" placeholder="لینک تصویر پس‌زمینه (URL)..." class="flex-1 bg-[#090d17] border border-white/15 rounded-lg px-2.5 py-1.5 text-xs text-white placeholder-slate-600 focus:outline-none focus:border-[#3F8FFE]" />
            <button id="btn-set-bg-url" type="button" class="px-3 py-1.5 rounded-lg bg-white/10 hover:bg-white/20 text-xs text-white transition">اعمال</button>
            <button id="btn-clear-bg-url" type="button" class="px-2.5 py-1.5 rounded-lg bg-white/5 hover:bg-white/10 text-xs text-slate-400 transition" title="حذف تصویر">✕</button>
          </div>
